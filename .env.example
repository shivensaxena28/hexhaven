# Copy this file to .env.local and fill in the values from your Supabase
# project. Never commit .env.local.
#
# VITE_SUPABASE_URL: Settings -> Data API -> "Project URL".
#   Must be exactly https://<project-ref>.supabase.co (no trailing path).
# VITE_SUPABASE_ANON_KEY: Settings -> API Keys -> the "Publishable key"
#   (sb_publishable_...). On older projects, the "anon public" JWT key.
#
# The publishable/anon key is safe to expose to browsers ONLY because Row
# Level Security is enabled on all tables (see supabase/schema.sql). A
# secret / service_role key must NEVER appear here or in frontend code.

VITE_SUPABASE_URL=<SUPABASE_URL>
VITE_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
