# Copy this file to .env.local and fill in the values from your Supabase
# project (Dashboard -> Project Settings -> API). Never commit .env.local.
#
# The anon key is safe to expose to browsers ONLY because Row Level Security
# is enabled on all tables (see supabase/schema.sql). The service_role key
# must NEVER appear here or anywhere in frontend code.

VITE_SUPABASE_URL=<SUPABASE_URL>
VITE_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
